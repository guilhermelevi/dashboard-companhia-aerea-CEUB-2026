                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Um número isolado informa. ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#63768A",
                      "fontFamily": "Segoe UI, wf_segoe-ui_normal, helvetica, arial, sans-serif"
                    }
                  },
                  {
                    "value": "Um número com contexto ajuda a decidir.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#134E5C",
                      "fontFamily": "Segoe UI, wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
