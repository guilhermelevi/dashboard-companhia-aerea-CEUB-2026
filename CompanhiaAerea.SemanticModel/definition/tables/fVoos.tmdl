/// Tabela fato: um registro por voo realizado ou cancelado.
table fVoos
	lineageTag: 1415eea7-964d-448e-a531-ccc43bc8dd52

	/// Identificador unico do voo
	column id_voo
		dataType: string
		lineageTag: 1b7b90da-dfac-4b5f-88e8-3ae382b2af08
		summarizeBy: none
		sourceColumn: id_voo

		annotation SummarizationSetBy = Automatic

	/// Numero comercial do voo
	column numero_voo
		dataType: string
		lineageTag: 50938a21-710a-46cb-9e2f-55fe7e06f4cd
