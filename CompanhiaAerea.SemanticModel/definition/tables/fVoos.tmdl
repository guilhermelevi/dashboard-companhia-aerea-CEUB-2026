	column mes_nome
		dataType: string
		lineageTag: 515b4488-cc4a-4725-8015-ca97e3d0862c
		summarizeBy: none
		sourceColumn: mes_nome

		annotation SummarizationSetBy = Automatic

	/// Competencia no formato AAAA-MM
	column ano_mes
		dataType: string
		lineageTag: 896aa2d7-4889-4a62-99b1-a245bb35de2d
		summarizeBy: none
		sourceColumn: ano_mes

		annotation SummarizationSetBy = Automatic

