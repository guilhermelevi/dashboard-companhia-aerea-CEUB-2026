	/// Data de realizacao do voo
	column data_voo
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4209f6c3-78bf-47c9-b15e-269d43a59ac6
		summarizeBy: none
		sourceColumn: data_voo
		variation Variacao
			isDefault
			relationship: rel_calendario_voos
			defaultHierarchy: dCalendario.'Hierarquia de Datas'


		annotation SummarizationSetBy = Automatic

