/// Tabela fato: um registro por voo. Contém apenas chaves e métricas — todo atributo descritivo vive nas dimensões.
table fVoos
	lineageTag: 784e4d5c-a8fe-4c16-8e17-6cca1060d03f

	/// Identificador único do voo (chave degenerada)
	column id_voo
		dataType: string
		lineageTag: 635d2fbd-0ca0-4e5f-9839-8697da456484
		summarizeBy: none
		sourceColumn: id_voo

		annotation SummarizationSetBy = Automatic

	/// Número comercial do voo (chave degenerada)
	column numero_voo
		dataType: string
		lineageTag: fcc1cf9d-2cbf-46c6-9971-11311f03b490
		summarizeBy: none
		sourceColumn: numero_voo

		annotation SummarizationSetBy = Automatic

	/// Data do voo — chave para dCalendario
	column data_voo
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7a8ce7b9-bdbd-40ee-9b46-3eaea6b81db1
		summarizeBy: none
		sourceColumn: data_voo

		annotation SummarizationSetBy = Automatic

	/// Aeroporto de partida — chave para dAeroporto
	column origem_iata
		dataType: string
		lineageTag: 94ec74c9-faad-4d51-9c4e-e8004a183c56
		summarizeBy: none
		sourceColumn: origem_iata

		annotation SummarizationSetBy = Automatic

	/// Par origem-destino — chave para dRota
	column rota
		dataType: string
		lineageTag: 12b24af3-e227-49ac-8a35-65f615511370
		summarizeBy: none
		sourceColumn: rota

		annotation SummarizationSetBy = Automatic

	/// Distância percorrida em quilômetros
	column distancia_km
		dataType: int64
		formatString: #,0
		lineageTag: 34be620f-2378-45ae-8e9c-bacc3ed5e40b
		summarizeBy: sum
		sourceColumn: distancia_km

		annotation SummarizationSetBy = Automatic

	/// Modelo da aeronave — chave para dAeronave
	column tipo_aeronave
		dataType: string
		lineageTag: 39e13c08-fa79-4b00-bdde-d93b87598961
		summarizeBy: none
		sourceColumn: tipo_aeronave

		annotation SummarizationSetBy = Automatic

	/// Assentos disponíveis no voo
	column capacidade_aeronave
		dataType: int64
		formatString: #,0
		lineageTag: 27181b3a-14b2-409f-a80b-cbd633da7ab2
		summarizeBy: sum
		sourceColumn: capacidade_aeronave

		annotation SummarizationSetBy = Automatic

	/// Passageiros transportados
	column passageiros
		dataType: int64
		formatString: #,0
		lineageTag: 9668eced-27f6-4f5e-ac71-fa17db9b3949
		summarizeBy: sum
		sourceColumn: passageiros

		annotation SummarizationSetBy = Automatic

	/// Passageiros dividido pela capacidade
	column taxa_ocupacao
		dataType: double
		formatString: 0.0%
		lineageTag: eabfa131-d2d6-4238-9a33-1bd7870bbd70
		summarizeBy: none
		sourceColumn: taxa_ocupacao

		annotation SummarizationSetBy = Automatic

	/// Preço médio pago por passageiro
	column preco_medio_passagem
		dataType: double
		formatString: "R$" #,0.00
		lineageTag: 4b3f4045-21ec-43d5-879c-655c02525601
		summarizeBy: none
		sourceColumn: preco_medio_passagem

		annotation SummarizationSetBy = Automatic

	/// Receita bruta do voo
	column receita_voo
		dataType: double
		formatString: "R$" #,0.00
		lineageTag: ab5dbf6b-aac2-41dc-992f-2981b61f6b57
		summarizeBy: sum
		sourceColumn: receita_voo

		annotation SummarizationSetBy = Automatic

	/// Custo operacional do voo
	column custo_voo
		dataType: double
		formatString: "R$" #,0.00
		lineageTag: d45276a4-977f-4275-af6c-dfcc59a956d8
		summarizeBy: sum
		sourceColumn: custo_voo

		annotation SummarizationSetBy = Automatic

	/// Receita menos custo
	column lucro_voo
		dataType: double
		formatString: "R$" #,0.00
		lineageTag: 220e0230-7879-4c60-9ed3-de802cf3ef13
		summarizeBy: sum
		sourceColumn: lucro_voo

		annotation SummarizationSetBy = Automatic

	/// Minutos de atraso na partida
	column atraso_minutos
		dataType: double
		formatString: #,0
		lineageTag: 4650b870-3d45-427d-b9a3-95c356036e10
		summarizeBy: none
		sourceColumn: atraso_minutos

		annotation SummarizationSetBy = Automatic

	/// Situação do voo — chave para dSituacao
	column situacao_voo
		dataType: string
		lineageTag: ae34ca11-dfd4-4d17-b606-ec74197c7ffa
		summarizeBy: none
		sourceColumn: situacao_voo

		annotation SummarizationSetBy = Automatic

	/// Causa registrada — chave para dMotivo
	column motivo_atraso_cancelamento
		dataType: string
		lineageTag: f143cc7f-1caa-4488-a9db-144cf9ebc6cb
		summarizeBy: none
		sourceColumn: motivo_atraso_cancelamento

		annotation SummarizationSetBy = Automatic

	/// Tempo de voo em minutos
	column duracao_minutos
		dataType: int64
		formatString: #,0
		lineageTag: d06c2fd3-5b29-43cf-9286-2078b39cec4e
		summarizeBy: none
		sourceColumn: duracao_minutos

		annotation SummarizationSetBy = Automatic

	/// Nota média de satisfação, de 1 a 5
	column satisfacao_passageiros
		dataType: double
		formatString: 0.0
		lineageTag: 9ab0f9a5-2a68-4441-bbe8-22fb5c576dd6
		summarizeBy: none
		sourceColumn: satisfacao_passageiros

		annotation SummarizationSetBy = Automatic

	/// Agrupa o atraso da linha em intervalos, para o histograma
	column 'Faixa de Atraso' =
			VAR a = fVoos[atraso_minutos]
			RETURN
			    SWITCH( TRUE(),
			        ISBLANK( a ), "Cancelado",
			        a <= 15,      "0-15 min (pontual)",
			        a <= 30,      "16-30 min",
			        a <= 60,      "31-60 min",
			        a <= 120,     "61-120 min",
			        "Acima de 120 min"
			    )
		dataType: string
		lineageTag: 83dd700e-8a61-4365-b497-726994805296
		summarizeBy: none
		sortByColumn: 'Ordem Faixa Atraso'

		annotation SummarizationSetBy = Automatic

	/// Ordenação das faixas de atraso
	column 'Ordem Faixa Atraso' =
			VAR a = fVoos[atraso_minutos]
			RETURN SWITCH( TRUE(), ISBLANK(a), 0, a <= 15, 1, a <= 30, 2, a <= 60, 3, a <= 120, 4, 5 )
		dataType: int64
		formatString: 0
		lineageTag: 2a2f9ebc-3b76-4249-8605-e9432c782b2b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Classifica o voo entre lucrativo e deficitário
	column 'Resultado do Voo' =
			IF( fVoos[situacao_voo] = "Cancelado", "Cancelado",
			    IF( fVoos[lucro_voo] >= 0, "Lucrativo", "Deficitario" ) )
		dataType: string
		lineageTag: 2fe27841-04c0-4c1e-8f39-342ef6eec103
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Agrupa a taxa de ocupação da linha em faixas
	column 'Faixa de Ocupacao' =
			VAR o = fVoos[taxa_ocupacao]
			RETURN
			    SWITCH( TRUE(),
			        fVoos[situacao_voo] = "Cancelado", "Cancelado",
			        o < 0.6,  "Abaixo de 60%",
			        o < 0.75, "60% a 75%",
			        o < 0.9,  "75% a 90%",
			        "Acima de 90%"
			    )
		dataType: string
		lineageTag: 4a12dff3-e7fd-4819-8d4f-0c2bfbbced3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fVoos = m
		mode: import
		queryGroup: Fato
		source =
				let
				    Colunas = Table.SelectColumns( Fonte, {
				        "id_voo", "numero_voo", "data_voo", "origem_iata", "rota", "tipo_aeronave",
				        "situacao_voo", "motivo_atraso_cancelamento", "distancia_km", "capacidade_aeronave",
				        "passageiros", "taxa_ocupacao", "preco_medio_passagem", "receita_voo", "custo_voo",
				        "lucro_voo", "atraso_minutos", "duracao_minutos", "satisfacao_passageiros" } )
				in
				    Colunas

	annotation PBI_ResultType = Table

