/// Dimensão de datas, derivada do período presente na fato.
table dCalendario
	lineageTag: 432a9368-9d28-4fe9-9658-2688d6f9b26a
	dataCategory: Time

	/// Data do calendário
	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 4f03b446-0294-4647-819f-f1ccc9ea0d22
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	/// Ano civil
	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 6cb08670-ca97-4c47-b60a-c6b78c6a5901
		summarizeBy: none
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	/// Trimestre do ano
	column Trimestre
		dataType: string
		lineageTag: 78c29c7a-79af-4606-b005-130ab2417c56
		summarizeBy: none
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	/// Número do mês, usado para ordenar
	column 'Numero do Mes'
		dataType: int64
		formatString: 0
		lineageTag: a466f5cb-9276-4f47-b3b1-e6a3e9132e1f
		summarizeBy: none
		sourceColumn: [Numero do Mes]

		annotation SummarizationSetBy = Automatic

	/// Mês abreviado
	column Mes
		dataType: string
		lineageTag: eefe10e0-4373-47e1-8b3e-34c47a1e0c2a
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: 'Numero do Mes'

		annotation SummarizationSetBy = Automatic

	/// Mês por extenso
	column 'Mes Completo'
		dataType: string
		lineageTag: 68594925-3a40-49ac-be2d-a63225b66e27
		summarizeBy: none
		sourceColumn: [Mes Completo]
		sortByColumn: 'Numero do Mes'

		annotation SummarizationSetBy = Automatic

	/// Competência no formato AAAA-MM
	column Ano-Mes
		dataType: string
		lineageTag: 3c51bbd9-a630-4349-8292-693d7be96180
		summarizeBy: none
		sourceColumn: [Ano-Mes]

		annotation SummarizationSetBy = Automatic

	/// Número do dia da semana (segunda = 1)
	column 'Numero Dia Semana'
		dataType: int64
		formatString: 0
		lineageTag: 28fa966a-6da6-4d94-ad48-7505066007b2
		summarizeBy: none
		sourceColumn: [Numero Dia Semana]

		annotation SummarizationSetBy = Automatic

	/// Dia da semana por extenso
	column 'Dia da Semana'
		dataType: string
		lineageTag: 8c4500a9-f9c5-4ff0-b9b9-50adff6ad764
		summarizeBy: none
		sourceColumn: [Dia da Semana]
		sortByColumn: 'Numero Dia Semana'

		annotation SummarizationSetBy = Automatic

	/// Separa dias úteis de fins de semana
	column 'Fim de Semana'
		dataType: string
		lineageTag: a6aa4465-a206-4b40-b2d1-3467517776dd
		summarizeBy: none
		sourceColumn: [Fim de Semana]

		annotation SummarizationSetBy = Automatic

	hierarchy 'Hierarquia de Datas'
		lineageTag: 9474c941-d040-4c06-bad4-5543cb7ea301

		level Ano
			lineageTag: 008d6228-c4f0-40e0-bb0a-42f0473eebbd
			column: Ano

		level Trimestre
			lineageTag: a93a2818-34c8-4493-afc1-20ce222f1bd5
			column: Trimestre

		level Mes
			lineageTag: 1b7756f2-6c93-42e8-b564-845331e21ce8
			column: 'Mes Completo'

	partition dCalendario = calculated
		mode: import
		source =
				VAR _min = MIN( fVoos[data_voo] )
				VAR _max = MAX( fVoos[data_voo] )
				RETURN
				ADDCOLUMNS(
				    CALENDAR( DATE( YEAR(_min), 1, 1 ), DATE( YEAR(_max), 12, 31 ) ),
				    "Ano",               YEAR( [Date] ),
				    "Trimestre",         "T" & FORMAT( [Date], "Q" ),
				    "Numero do Mes",     MONTH( [Date] ),
				    "Mes",               FORMAT( [Date], "MMM", "pt-BR" ),
				    "Mes Completo",      FORMAT( [Date], "MMMM", "pt-BR" ),
				    "Ano-Mes",           FORMAT( [Date], "yyyy-MM" ),
				    "Numero Dia Semana", WEEKDAY( [Date], 2 ),
				    "Dia da Semana",     FORMAT( [Date], "dddd", "pt-BR" ),
				    "Fim de Semana",     IF( WEEKDAY( [Date], 2 ) > 5, "Fim de semana", "Dia util" )
				)

	annotation PBI_Id = dCalendario

