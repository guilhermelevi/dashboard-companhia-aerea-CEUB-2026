/// Dimensao de datas, gerada a partir do periodo presente na tabela de voos.
table dCalendario
	lineageTag: 505fcfd7-03fe-4b52-ac21-436642764056
	dataCategory: Time

	/// Data do calendario
	column 'Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: d7b90a8d-bb69-4a5b-9667-3e4277b92a70
		summarizeBy: none
		isKey
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	/// Ano civil
	column 'Ano'
		dataType: int64
		formatString: 0
		lineageTag: 4bf478be-8b44-46e6-a940-7eff3c6e40ed
		summarizeBy: none
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	/// Trimestre do ano
	column 'Trimestre'
		dataType: string
		lineageTag: d992694c-7b1b-46c2-8d50-8d47dc0f6d4e
		summarizeBy: none
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	/// Ano e trimestre concatenados
	column 'Ano-Trimestre'
		dataType: string
		lineageTag: 42d56763-9afa-4b31-bb93-6c50f393fdcc
		summarizeBy: none
		sourceColumn: [Ano-Trimestre]

		annotation SummarizationSetBy = Automatic

	/// Numero do mes, usado para ordenacao
	column 'Numero do Mes'
		dataType: int64
		formatString: 0
		lineageTag: 1dfe992c-a104-46e6-a73b-231e1d9356b2
		summarizeBy: none
		sourceColumn: [Numero do Mes]

		annotation SummarizationSetBy = Automatic

	/// Mes abreviado
	column 'Mes'
		dataType: string
		lineageTag: 8a9e323d-3b90-4c76-a392-fd026294ecf9
		summarizeBy: none
		sortByColumn: 'Numero do Mes'
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	/// Mes por extenso
	column 'Mes Completo'
		dataType: string
		lineageTag: fb71e648-4ff1-4a82-b772-add35079b3b2
		summarizeBy: none
		sortByColumn: 'Numero do Mes'
		sourceColumn: [Mes Completo]

		annotation SummarizationSetBy = Automatic

	/// Competencia AAAA-MM, usada para ordenar a serie temporal
	column 'Ano-Mes'
		dataType: string
		lineageTag: 16ea1dc0-219d-4b3b-9554-aa10e8a85b11
		summarizeBy: none
		sourceColumn: [Ano-Mes]

		annotation SummarizationSetBy = Automatic

	/// Rotulo curto da competencia para eixos de grafico
	column 'Mes/Ano'
		dataType: string
		lineageTag: 04abc610-8f2b-4811-9d2b-dccbde06ca77
		summarizeBy: none
		sortByColumn: 'Ano-Mes'
		sourceColumn: [Mes/Ano]

		annotation SummarizationSetBy = Automatic

	/// Numero do dia da semana (segunda = 1)
	column 'Numero Dia Semana'
		dataType: int64
		formatString: 0
		lineageTag: 53c19ac4-34f7-439e-a54f-770468cc0984
		summarizeBy: none
		sourceColumn: [Numero Dia Semana]

		annotation SummarizationSetBy = Automatic

	/// Dia da semana por extenso
	column 'Dia da Semana'
		dataType: string
		lineageTag: 9c7c5283-0fba-4760-9b52-dca3c8dde6f1
		summarizeBy: none
		sortByColumn: 'Numero Dia Semana'
		sourceColumn: [Dia da Semana]

		annotation SummarizationSetBy = Automatic

	/// Separa dias uteis de fins de semana
	column 'Fim de Semana'
		dataType: string
		lineageTag: e956e35b-8c5a-4f0d-a42e-f2477becea22
		summarizeBy: none
		sourceColumn: [Fim de Semana]

		annotation SummarizationSetBy = Automatic

	hierarchy 'Hierarquia de Datas'
		lineageTag: 0c54974c-a129-4fe8-abd1-2e23403aed6e

		level Ano
			lineageTag: 8f043e56-0337-4e63-98d8-874139f9aedc
			column: Ano

		level Trimestre
			lineageTag: 543d46f7-259f-4ef1-beb3-60a949dd21f0
			column: Trimestre

		level Mes
			lineageTag: de0fdea8-e772-4989-89df-2b8692c422ef
			column: 'Mes Completo'

	partition dCalendario = calculated
		mode: import
		source =
				VAR _min = MIN( fVoos[data_voo] )
				VAR _max = MAX( fVoos[data_voo] )
				RETURN
				ADDCOLUMNS(
				    CALENDAR( DATE( YEAR(_min), 1, 1 ), DATE( YEAR(_max), 12, 31 ) ),
				    "Ano",            YEAR( [Date] ),
				    "Trimestre",      "T" & FORMAT( [Date], "Q" ),
				    "Ano-Trimestre",  YEAR( [Date] ) & "-T" & FORMAT( [Date], "Q" ),
				    "Numero do Mes",  MONTH( [Date] ),
				    "Mes",            FORMAT( [Date], "MMM", "pt-BR" ),
				    "Mes Completo",   FORMAT( [Date], "MMMM", "pt-BR" ),
				    "Ano-Mes",        FORMAT( [Date], "yyyy-MM" ),
				    "Mes/Ano",        FORMAT( [Date], "MMM/yy", "pt-BR" ),
				    "Numero Dia Semana", WEEKDAY( [Date], 2 ),
				    "Dia da Semana",  FORMAT( [Date], "dddd", "pt-BR" ),
				    "Fim de Semana",  IF( WEEKDAY( [Date], 2 ) > 5, "Fim de semana", "Dia util" )
				)

	annotation PBI_Id = dCalendario
