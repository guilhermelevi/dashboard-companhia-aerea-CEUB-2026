model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Parametros'

queryGroup Fato

queryGroup Dimensoes

annotation PBI_QueryOrder = ["pUrlOneDrive","pNomeArquivo","fVoos","dAeroporto"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fVoos
ref table dCalendario
ref table dAeroporto
ref table _Medidas
ref cultureInfo pt-BR
