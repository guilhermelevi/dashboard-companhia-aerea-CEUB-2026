                      "fontFamily": "Segoe UI, wf_segoe-ui_normal, helvetica, arial, sans-serif"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Decisão   ",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#E8A33D",
                      "fontFamily": "Segoe UI, wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Concentrar o plano de pontualidade nos três aeroportos do eixo Rio–São Paulo, revisando alocação de slots, tempo de solo e horários de partida. Atacar apenas esses três terminais alcança a maior parte do problema sem mexer no resto da malha.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#63768A",
                      "fontFamily": "Segoe UI, wf_segoe-ui_normal, helvetica, arial, sans-serif"
